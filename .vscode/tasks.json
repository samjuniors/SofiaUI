{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Antigravity: Run Local Gemma (Ollama)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/agy_sample.py",
        "--mode",
        "ollama",
        "--model",
        "gemma4:cloud"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Antigravity: Run Hybrid Cloud Architect + Local Worker",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/agy_sample.py",
        "--mode",
        "hybrid"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Antigravity: Run Local Gemma (LiteRT)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/agy_sample.py",
        "--mode",
        "litert"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
