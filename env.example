# Copy to .env.local in the project root (gitignored) and fill in your keys.
# Server-only — never prefix these with VITE_ (that would leak them to the browser).

# 👂 EAR (Hearing / STT)
# Deepgram — live STT (nova-3 streaming) + Aura TTS fallback
DEEPGRAM_API_KEY=

# 👄 MOUTH (Speaking / TTS)
# ElevenLabs — High-fidelity persona-based neural TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=bMxLr8fP6hzNRRi9nJxU
SOPHIA_VOICE_ID=bMxLr8fP6hzNRRi9nJxU
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Deepgram Aura TTS model
DEEPGRAM_VOICE_MODEL=aura-2-thalia-en

# 🧠 BRAIN (Thinking / LLM)
# Cloud Brains (Pick any or multiple):
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local LLM Brains (Ollama / LM Studio — No API key needed!):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ornith-1.5:9b

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Brain Mode: auto | ollama | lmstudio | gemini | grok | claude | openai
SOPHIA_BRAIN_MODE=auto
