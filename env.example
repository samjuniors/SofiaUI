# Copy to .env.local in the project root (gitignored) and fill in keys.
# Server-only — never prefix these with VITE_ (that would leak them to the browser).

# Deepgram — live STT (nova-3) + Aura TTS fallback
DEEPGRAM_API_KEY=

# Gemini Live — primary realtime voice (optional; Deepgram is used if this is empty)
GOOGLE_API_KEY=

# Optional extra LLM brain. If unset, the platform XAI_API_KEY or Gemini text is used.
# XAI_API_KEY is injected automatically in this environment.
